# Security and caching configuration for Cloudflare Pages

# Cache hashed assets indefinitely (Astro builds with content hashes in _astro)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache static images with revalidation
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# HTML pages - revalidate so updates are immediate on new deployments
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Global security headers for all paths
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

