---
import ChitBasicsPage from "../components/chit/ChitBasicsPage.svelte";
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<!-- Favicon & App Icons -->
		<link
			rel="icon"
			type="image/png"
			sizes="32x32"
			href="/favicon-32x32.png"
		/>
		<link
			rel="icon"
			type="image/png"
			sizes="16x16"
			href="/favicon-16x16.png"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/apple-touch-icon.png"
		/>
		<link rel="shortcut icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Meta Tags -->
		<title>Chit Fund Guide – Chit Basics, Terms & How Chits Work</title>
		<meta
			name="description"
			content="Bilingual (മലയാളം/English) educational guide explaining what a chit fund is, how chits work, and essential terms like dividend, discount, prize money, security, and foreman commission."
		/>
		<meta
			name="keywords"
			content="Chit Fund, Chitty, Chit Basics, Chit Terms, Dividend, Discount, Prize Money, Foreman Commission, Malayalam, English, KSFE, substitution, ചിട്ടി പദങ്ങൾ"
		/>

		<script
			async
			src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8457432011414861"
			crossorigin="anonymous"></script>
		<!-- Google Fonts & Material Icons -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Inter:wght@400;500;600&family=Manjari:wght@400;700&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
			rel="stylesheet"
		/>
		<script
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-0JS4FVR6WF"
		></script><script>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());

			gtag("config", "G-0JS4FVR6WF");
		</script>
		<script is:inline>
			if (localStorage.getItem('app-theme') === 'dark') {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<!-- Google tag (gtag.js) -->

	<body class="bg-background text-on-surface transition-colors duration-500">
		<ChitBasicsPage client:load />
	</body>
</html>
