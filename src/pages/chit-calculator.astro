---
import ChitWorkingCalculator from '../components/ChitWorkingCalculator.svelte';
import '../styles/global.css';

const siteUrl = "https://chits.online";
const canonicalUrl = `${siteUrl}/chit-calculator`;
const ogImageUrl = `${siteUrl}/images/og-image.png`;

const appSchema = {
	"@context": "https://schema.org",
	"@type": "WebApplication",
	"name": "Chit Working & Lifecycle Calculator",
	"url": canonicalUrl,
	"applicationCategory": "FinanceApplication",
	"operatingSystem": "All",
	"browserRequirements": "Requires JavaScript. Requires HTML5.",
	"description": "Interactive Chit Fund Working Calculator. Input months and chit value to simulate monthly reverse auctions, dividend payouts, installment savings, break-even months, and prize money curves.",
	"offers": {
		"@type": "Offer",
		"price": "0",
		"priceCurrency": "INR"
	}
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Home",
			"item": siteUrl
		},
		{
			"@type": "ListItem",
			"position": 2,
			"name": "Chit Working Calculator",
			"item": canonicalUrl
		}
	]
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		
		<!-- Primary SEO Meta Tags -->
		<title>Chit Working & Lifecycle Calculator – Reverse Auction & Dividend Simulation | chits.online</title>
		<meta name="title" content="Chit Working & Lifecycle Calculator – Reverse Auction & Dividend Simulation | chits.online" />
		<meta name="description" content="Interactive Chit Fund Working Calculator. Input duration in months and chit value to simulate monthly reverse auctions, dividend distribution, net installments, break-even month, and prize money graphs." />
		<meta name="keywords" content="Chit Working, Chit Calculator, Chit Fund Months Amount, Chit Simulation, Reverse Auction, Dividends, Chit Basics, KSFE, ചിട്ടി കാൽക്കുലേറ്റർ, ലേല കാൽക്കുലേറ്റർ" />
		<meta name="author" content="chits.online" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

		<!-- Open Graph / Facebook / WhatsApp -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="chits.online" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content="Chit Working & Lifecycle Calculator – Reverse Auction & Dividend Simulation" />
		<meta property="og:description" content="Simulate how chits work in real time: visualize gross vs. net installments, monthly reverse auction discounts, dividend pools, and the break-even savings month." />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="chits.online - Chit Working Calculator" />
		<meta property="og:locale" content="en_IN" />
		<meta property="og:locale:alternate" content="ml_IN" />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content="Chit Working & Lifecycle Calculator | chits.online" />
		<meta name="twitter:description" content="Interactive chit lifecycle calculator. Enter chit value and duration in months to see real-time visual curves of auctions, dividends, and payouts." />
		<meta name="twitter:image" content={ogImageUrl} />

		<!-- Mobile & PWA Theme Colors -->
		<meta name="theme-color" content="#008f58" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#060e1a" media="(prefers-color-scheme: dark)" />
		<link rel="manifest" href="/site.webmanifest" />

		<!-- Favicon & App Icons -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="shortcut icon" href="/favicon.ico" />

		<!-- Google AdSense -->
		<script
			async
			src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8457432011414861"
			crossorigin="anonymous"></script>
		
		<!-- Google Fonts & Material Icons -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Inter:wght@400;500;600&family=Manjari:wght@400;700&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

		<!-- Google Analytics (gtag.js) -->
		<script
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-0JS4FVR6WF"
		></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());
			gtag("config", "G-0JS4FVR6WF");
		</script>

		<!-- Theme Init (Prevent Flash) -->
		<script is:inline>
			if (localStorage.getItem('app-theme') === 'dark') {
				document.documentElement.classList.add('dark');
			}
		</script>

		<!-- Schema.org Structured Data (JSON-LD) -->
		<script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</head>
	<body class="bg-background text-on-surface transition-colors duration-500">
		<ChitWorkingCalculator client:load />
	</body>
</html>
