---
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		
		<title>404 - Page Not Found | Substitution Chits</title>
		<meta name="description" content="Page not found. Return to Chit Fund Guide or Loan EMI Calculator." />
		
		<!-- Google Fonts & Material Icons -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Inter:wght@400;500;600&family=Manjari:wght@400;700&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-background text-on-surface transition-colors duration-500 min-h-screen flex items-center justify-center p-4">
		<main class="max-w-md w-full text-center p-8 rounded-3xl border border-[var(--outline-variant)] bg-[var(--surface)] backdrop-blur-xl shadow-xl">
			<div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-[var(--primary-container)] text-[var(--primary)] mb-6">
				<span class="material-symbols-outlined text-4xl">search_off</span>
			</div>
			
			<h1 class="text-6xl font-bold font-display text-[var(--primary)] mb-2">404</h1>
			<h2 class="text-xl font-semibold mb-2">Page Not Found / പേജ് കണ്ടെത്താനായില്ല</h2>
			<p class="text-[var(--on-surface-variant)] text-sm mb-8 leading-relaxed">
				The page you're looking for doesn't exist or has moved. Please head back to our guide or calculator.
			</p>
			
			<div class="flex flex-col sm:flex-row gap-3 justify-center">
				<a href="/" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[var(--primary)] text-[var(--on-primary)] font-medium text-sm transition-transform hover:-translate-y-0.5 shadow-md">
					<span class="material-symbols-outlined text-base">home</span>
					<span>Chit Basics</span>
				</a>
				<a href="/calculator" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl border border-[var(--outline-variant)] bg-[var(--surface)] text-[var(--on-surface)] font-medium text-sm transition-transform hover:-translate-y-0.5">
					<span class="material-symbols-outlined text-base">calculate</span>
					<span>EMI Calculator</span>
				</a>
			</div>
		</main>
	</body>
</html>

